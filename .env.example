# Copie ce fichier vers .env et remplis les valeurs.
# .env n'est jamais commité (cf. .gitignore).

PAYBYPHONE_USERNAME=
PAYBYPHONE_PASSWORD=
DEFAULT_VEHICLE_PLATE=AA-000-AA
DEFAULT_DURATION_MINUTES=15
COOLDOWN_MINUTES=10
DETECTION_CONFIDENCE_THRESHOLD=0.5
DETECTION_CONSECUTIVE_FRAMES=3

# Mode paiement : "assisted" (iMessage → tu valides) ou "auto" (full API, après reverse Phase 5)
PAYMENT_MODE=assisted

# Pour le mode assisted : ton numéro iPhone au format international (ex: +33612345678)
ASSISTED_IMESSAGE_RECIPIENT=

# Pour le mode auto : choix du provider (paybyphone, easypark, flowbird, opngo)
PAYMENT_PROVIDER=paybyphone

# Credentials par provider (uniquement le provider sélectionné est utilisé)
EASYPARK_USERNAME=
EASYPARK_PASSWORD=
FLOWBIRD_USERNAME=
FLOWBIRD_PASSWORD=
OPNGO_API_KEY=
