# Production-ish Raspberry Pi config.
# Copy to /opt/boring/.env and fill secrets locally.

PAYMENT_MODE=auto
PAYMENT_PROVIDER=paybyphone
PAYMENT_DRY_RUN=true

PAYBYPHONE_USERNAME=
PAYBYPHONE_PASSWORD=
PAYBYPHONE_API_BASE=
PAYBYPHONE_AUTH_URL=
PAYBYPHONE_CLIENT_ID=
PAYBYPHONE_RATE_OPTION_ID=
PAYBYPHONE_PAYMENT_METHOD_ID=
PAYBYPHONE_LOCATION_ID=

DEFAULT_VEHICLE_PLATE=AA-000-AA
DEFAULT_DURATION_MINUTES=15
COOLDOWN_MINUTES=10
MAX_SESSION_AMOUNT_CENTS=500
MAX_DAILY_AMOUNT_CENTS=1500
POSITION_MODE=static
GPSD_HOST=127.0.0.1
GPSD_PORT=2947

BOX_LAT=
BOX_LON=
BOX_REQUIRE_GEOFENCE=true
PARKING_ZONES_PATH=data/lille_parking_zones.geojson
BOX_STATE_PATH=/var/lib/boring/state.json
BOX_EVENT_LOG_PATH=/var/lib/boring/events.jsonl
BOX_EVENT_LOG_MAX_BYTES=5000000
BOX_EVENT_LOG_BACKUPS=3
BOX_DISK_MIN_FREE_MB=512
BOX_DISK_CHECK_SECONDS=300
BOX_READINESS_MAX_REPORT_AGE_HOURS=72
BOX_READY_MAX_HEARTBEAT_GAP_SECONDS=1800

CAMERA_DEVICE=0
DETECTION_MODEL=models/best.pt
DETECTION_TARGET_LABELS=control_vehicle
DETECTION_DEVICE=cpu
DETECTION_CONFIDENCE_THRESHOLD=0.65
DETECTION_CONSECUTIVE_FRAMES=4
DETECTION_FPS=2.0
LOW_POWER_DETECTION_FPS=0.5

BATTERY_LOW_PERCENT=25
BATTERY_CRITICAL_PERCENT=10
BATTERY_RECOVERED_PERCENT=35
BATTERY_CAPACITY_WH=100
ESTIMATED_DRAW_WATTS=8.0
REQUIRED_RUNTIME_HOURS=10.0
POWER_RESERVE_PERCENT=15.0
VEHICLE_CHARGE_WATTS=30.0
DAILY_DRIVE_RECHARGE_HOURS=1.0
CHARGE_EFFICIENCY=0.85
POWER_CHECK_SECONDS=60
THERMAL_WARNING_C=75.0
THERMAL_CRITICAL_C=85.0
THERMAL_CHECK_SECONDS=60
NETWORK_CHECK_SECONDS=60
NETWORK_PROBE_TARGET=1.1.1.1:443
NETWORK_RECOVERY_COMMAND=sh /opt/boring/deploy/pi/network-recover.example.sh
NETWORK_RECOVERY_COOLDOWN_SECONDS=300
NETWORK_RECOVERY_TIMEOUT_SECONDS=20
BOX_HEARTBEAT_SECONDS=900
BORING_NOTIFY_WEBHOOK_URL=
